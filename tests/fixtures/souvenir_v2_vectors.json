    {
      "name": "stalls, rollback and overflow",
      "steps": [
        {
          "prefix": "event",
          "now_ms": 1793531580000,
          "draws_hex": [
            "5"
          ],
          "timestamp_ms": 1793531580000,
          "random_hex": "0000000000000000005",
          "text": "event_00t35pg1sg000000000000005",
          "why": "first ID: 74 fresh bits"
        },
        {
          "prefix": "event",
          "now_ms": 1793531580000,
          "draws_hex": [
            "0"
          ],
          "timestamp_ms": 1793531580000,
          "random_hex": "0000000000000000006",
          "text": "event_00t35pg1sg000000000000006",
          "why": "same millisecond: smallest step, 1"
        },
        {
          "prefix": "event",
          "now_ms": 1793531579999,
          "draws_hex": [
            "ffffffff"
          ],
          "timestamp_ms": 1793531580000,
          "random_hex": "0000000000100000006",
          "text": "event_00t35pg1sg000000004000006",
          "why": "clock went back: keep the timestamp; largest step, 2^32"
        },
        {
          "prefix": "event",
          "now_ms": 1793531580001,
          "draws_hex": [
            "3ffffffffffffffffff"
          ],
          "timestamp_ms": 1793531580001,
          "random_hex": "3ffffffffffffffffff",
          "text": "event_00t35pg1sgzzzzzzzzzzzzzzz",
          "why": "clock moved on: 74 fresh bits"
        },
        {
          "prefix": "event",
          "now_ms": 1793531580001,
          "draws_hex": [
            "0",
            "7"
          ],
          "timestamp_ms": 1793531580002,
          "random_hex": "0000000000000000007",
          "text": "event_00t35pg1sh000000000000007",
          "why": "random field overflows: borrow the next millisecond and draw 74 fresh bits"
        },
        {
          "prefix": "event",
          "now_ms": 1793531580001,
          "draws_hex": [
            "1"
          ],
          "timestamp_ms": 1793531580002,
          "random_hex": "0000000000000000009",
          "text": "event_00t35pg1sh000000000000009",
          "why": "clock is now behind the generator: step from the borrowed millisecond"
        },
        {
          "prefix": "org",
          "now_ms": 1793531580002,
          "draws_hex": [
            "0"
          ],
          "timestamp_ms": 1793531580002,
          "random_hex": "000000000000000000a",
          "text": "org_00t35pg1sh00000000000000a",
          "why": "another prefix shares the state; this ID is less than the one before, though its body is greater"
        },
        {
          "prefix": "event",
          "now_ms": 1793531580003,
          "draws_hex": [
            "3fffffffffffffffffe"
          ],
          "timestamp_ms": 1793531580003,
          "random_hex": "3fffffffffffffffffe",
          "text": "event_00t35pg1shzzzzzzzzzzzzzzy",
          "why": "clock moved on"
        },
        {
          "prefix": "event",
          "now_ms": 1793531580003,
          "draws_hex": [
            "0"
          ],
          "timestamp_ms": 1793531580003,
          "random_hex": "3ffffffffffffffffff",
          "text": "event_00t35pg1shzzzzzzzzzzzzzzz",
          "why": "a step that lands exactly on 2^74 - 1 does not overflow"
        }
      ]
    },
    {
      "name": "end of the timestamp range",
      "steps": [
        {
          "prefix": "event",
          "now_ms": 281474976710655,
          "draws_hex": [
            "3ffffffffffffffffff"
          ],
          "timestamp_ms": 281474976710655,
